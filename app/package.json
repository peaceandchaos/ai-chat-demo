{
  "name": "MargeloChat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "format": "cd .. && app/node_modules/.bin/oxfmt --config app/.oxfmtrc.json --write .",
    "format:check": "cd .. && app/node_modules/.bin/oxfmt --config app/.oxfmtrc.json --check .",
    "secrets": "node tools/check-credentials.cjs",
    "secrets:staged": "node tools/check-credentials.cjs --staged",
    "security": "rnsec scan --path .",
    "react-compiler-check": "react-compiler-healthcheck",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package --error-on-fail",
    "prepare": "cd .. && husky .husky"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.0",
    "@legendapp/list": "^3.3.0",
    "@lodev09/react-native-true-sheet": "^3.11.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@shopify/react-native-skia": "^2.6.8",
    "react": "19.2.3",
    "react-freeze": "^1.0.4",
    "react-native": "0.86.0",
    "react-native-bootsplash": "^7.3.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-enriched-markdown": "^0.6.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-keyboard-controller": "^1.21.12",
    "react-native-nitro-fetch": "^1.4.2",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-nitro-symbols": "^0.0.8",
    "react-native-nitro-text-decoder": "^0.2.0",
    "react-native-nitro-web-image": "^0.15.1",
    "react-native-nitro-websockets": "^1.1.0",
    "react-native-pager-view": "^8.0.2",
    "react-native-performance": "^6.0.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-release-profiler": "^0.4.4",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-worklets": "^0.10.0",
    "zeego": "^3.0.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@oxlint/plugins": "1.86.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "9.1.7",
    "jest": "^29.6.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "react-compiler-healthcheck": "^1.0.0",
    "react-test-renderer": "19.2.3",
    "rnsec": "1.3.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.23.3"
  },
  "overrides": {
    "zeego": {
      "@react-native-menu/menu": "$@react-native-menu/menu",
      "react-native-ios-context-menu": "$react-native-ios-context-menu",
      "react-native-ios-utilities": "$react-native-ios-utilities"
    },
    "react-dom": "19.2.3"
  }
}
