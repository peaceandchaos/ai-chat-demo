        "tools/skills/records.cjs"
      ],
      "findings": [
        {
          "finding": "The binding rule rests on one fact: a receipt's head is an ancestor of the commit that records it, so a receipt copied from a merged record cannot match a later range by SHA.",
          "cites": "Steps 2",
          "none": "The cherry-pick and rebase tests run the rule on real commits."
        },
        {
          "finding": "Records 1 to 4 have no cites or receipts, so they fail the new schema.",
          "cites": "Steps 4",
          "none": "By owner decision, those records are replaced with receipt-backed ones before PRs 1 to 4 merge."
        },
        {
          "finding": "The Read path of the hook rested on an unrun assumption about the Claude Code Read response. A full Read of a SKILL.md in a throwaway range produced a non-partial receipt that skills:record accepted, and a Read with limit produced none that it accepted.",
          "cites": "Steps 5",
          "none": "The live probe confirmed the assumption. It ran outside the repository and left nothing behind."
        },
        {
          "finding": "Reviewer coverage applies only when some record in the range has a review section, so a range whose records have none passes without any reviewer receipt.",
          "cites": "Steps 4",
          "none": "docs/skills.md states the rule. Requiring a review section would fail the author's own pre-push run. The owner decides whether acceptance needs it."
        }
      ],
